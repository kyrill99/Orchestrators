# Copy to .env and fill in values:
#   cp .env.example .env

# Google Gemini API key (required)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gradium API key (server-only; browser gets short-lived tokens via POST /api/voice/token)
# https://docs.gradium.ai
GRADIUM_API_KEY=

# Shared SQLite file (default: data/orchestrators.db). Used by task graph,
# memory, and per-user state when the sqlite backends are selected.
# DATABASE_PATH=data/orchestrators.db

# Backends (default: sqlite). Set to jsonl / markdown to keep the old file stores.
# TASKGRAPH_STORE=sqlite
# MEMORY_STORE=sqlite

# Legacy file paths (also used once to import into SQLite on first start)
# TASKGRAPH_PATH=data/taskgraph.jsonl
# MEMORY_PATH=data/memory

# Optional: project/owner binding for interview agent + MCP memory tools.
# The interview chat uses the signed-in user as owner unless MEMORY_USER_ID is set.
# MEMORY_PROJECT_ID=default
# MEMORY_USER_ID=default
# INTERVIEW_AGENT_ID=interview

# Optional: local signed-in user when oauth2-proxy headers are absent
# DEV_USER_EMAIL=local@localhost

# Optional: comma-separated origins allowed to call the API (default: http://localhost:3000)
# CORS_ORIGINS=http://localhost:3000

# Agent runs (see taskgraph/API.md). With GEMINI_API_KEY set, runs execute as
# in-process Gemini agents (TASKGRAPH_RUNNER=gemini); otherwise they are only recorded.
# TASKGRAPH_RUNNER=gemini
# GEMINI_WORKER_MODEL=gemini-3.8-flash
# GEMINI_WORKER_MAX_STEPS=40
# GEMINI_WORKER_MAX_SECONDS=1200
# GEMINI_WORKER_BUILTIN_TOOLS=google_search,code_execution
# Engine: starts runs on ready tasks while running (state persists; default stopped)
# ENGINE_MAX_RUNS=2
# ENGINE_INTERVAL=2
# ENGINE_MAX_ATTEMPTS=3
