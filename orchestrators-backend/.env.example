# Copy to .env and fill in values:
#   cp .env.example .env

# Google Gemini API key (required)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gradium API key
GRADIUM_API_KEY=

# Optional: where memory files live (default: data/memory)
# MEMORY_PATH=data/memory

# Optional: comma-separated origins allowed to call the API (default: http://localhost:3000)
# CORS_ORIGINS=http://localhost:3000
