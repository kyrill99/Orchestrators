# Copy to .env and fill in values:
#   cp .env.example .env

# Google Gemini API key (required)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gradium API key (server-only; browser gets short-lived tokens via POST /api/voice/token)
# https://docs.gradium.ai
GRADIUM_API_KEY=

# Optional: CORS is open to localhost:3000/3001 by default
# FRONTEND_ORIGIN=http://localhost:3000
