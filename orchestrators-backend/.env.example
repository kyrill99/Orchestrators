# Copy to .env and fill in values:
#   cp .env.example .env

# Google Gemini API key (required)
# https://aistudio.google.com/apikey
GEMINI_API_KEY=

# Gradium API key (server-only; browser gets short-lived tokens via POST /api/voice/token)
# https://docs.gradium.ai
GRADIUM_API_KEY=

# Optional: where memory files live (default: data/memory)
# MEMORY_PATH=data/memory

# Optional: project/owner binding for interview agent + MCP memory tools
# MEMORY_PROJECT_ID=default
# MEMORY_USER_ID=default
# INTERVIEW_AGENT_ID=interview

# Optional: comma-separated origins allowed to call the API (default: http://localhost:3000)
# CORS_ORIGINS=http://localhost:3000
